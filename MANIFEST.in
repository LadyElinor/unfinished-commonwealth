include LICENSE README.md ROADMAP.md CONTRIBUTING.md
recursive-include docs *.md
recursive-include examples *.md *.json
recursive-include scripts *.py *.mjs
recursive-include tests *.py *.json
recursive-include commonwealth/data *.json
exclude .local/*

recursive-include client_dist/src *.py *.txt
include client_dist/pyproject.toml client_dist/README.md
prune client_dist/build
prune client_dist/src/unfinished_commonwealth_client.egg-info
recursive-include examples/agent_profile_v1 *.py *.mjs
recursive-include research/grok_integration *.py
